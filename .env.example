DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/eve_healthcare
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/eve_healthcare_test
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_WEBHOOK_PER_MINUTE=120
CACHE_TTL_SECONDS=60
ENVIRONMENT=development
